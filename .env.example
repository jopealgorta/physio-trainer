# Copy to .env.local and fill in. `pnpm db:start` prints local Supabase values.

# Public URL of the app, used to build share links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API, or output of `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Postgres connection used by Drizzle (server only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Set to 1 to skip env validation (CI builds, Docker image builds)
# SKIP_ENV_VALIDATION=1

# Show "Continue with Google" on /login (needs the Google provider enabled in Supabase)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Set to false to hide the magic-link form (e.g. no custom SMTP yet). Ignored when Google is off.
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=true

# Only for trying Google sign-in against local Supabase (read by supabase/config.toml).
# Export them in your shell before `pnpm db:start`; never commit real values.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
